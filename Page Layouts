    <title>Character</title>
<style>

    .container {
        max-width: 900px; /*changes borders size*/
        margin: 0 auto; 
        padding: 20px; /*changed the distance between the image paragraphs (image w/ paragraphs and the border*/
        border: 1px solid #ccc;
        border-radius: 10px;
        background-color: #f9f9f9; /*change background inside border*/
    }
    .image-paragraph {
        display: flex;
        align-items: center;
        gap: 30px; /*distance between the image and text*/
        margin: 20px 0;
    }

    .image-paragraph-reverse {
        display: flex;
        align-items: center;
        gap: 30px;
        margin: 20px 0;
        flex-direction: row-reverse; 
    }

    .image-paragraph img, .image-paragraph-reverse img {
        width: 300px;	
        height: auto;
        border-radius: 10px;
    }

    .image-paragraph p, .image-paragraph-reverse p {
        max-width: 600px; /*how large the paragraph is*/
        text-align: left;
        font-size: 18px;
        line-height: 1.5;
    }
.image-paragraph img:not(.small-img),
.image-paragraph-reverse img:not(.small-img) {
    width: 300px; /*the size of the image*/
    height: auto;
    border-radius: 10px;
    padding: 5px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.small-img {
    width: 150px; /* size of the smaller images (abilities)*/
    height: auto;
    border-radius: 10px;
    align-self: center;
    padding: 5px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

</style>
</head>

